      "unit": "USD_CENTS",
      "valueCents": 200000,
    },
    {
      "code": "TOTAL_RISK_RESERVE",
      "formulaText": "open dispute reserve + expected refund exposure = 125000 + 200000 = 325000",
      "label": "Total risk reserve",
      "unit": "USD_CENTS",
      "valueCents": 325000,
    },
    {
      "code": "SAFE_SURPLUS",
      "formulaText": "mean or baseline monthly net is not positive; surplus pinned to 0",
      "label": "Safe-to-invest surplus",
      "unit": "USD_CENTS",
      "valueCents": 0,
    },
    {
      "code": "STAGED_MONTHLY_TRANCHE",
      "formulaText": "no surplus to stage; all 4 tranches are 0",
      "label": "First staging tranche",
      "unit": "USD_CENTS",
      "valueCents": 0,
