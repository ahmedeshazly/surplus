      "valueCents": 3000000,
    },
    {
      "code": "BASELINE_MONTHLY_NET",
      "formulaText": "median(monthly net over 12 completed months) = 520000",
      "label": "Baseline monthly net (median)",
      "unit": "USD_CENTS",
      "valueCents": 520000,
    },
    {
      "code": "VOLATILITY_CV",
      "formulaText": "round4(sample std dev / max(mean, baseline)) = 322334.05 / 520000 = 0.6199",
      "label": "Income volatility (CV)",
      "unit": "RATIO",
      "valueScalar": 0.6199,
    },
    {
      "code": "BUFFER_MONTHS",
      "formulaText": "round2(clamp(3 + 6 * cv, 3, 9)) = clamp(3 + 6 * 0.6199, 3, 9) = 6.72",
      "label": "Cash buffer runway",
      "unit": "MONTHS",
      "valueScalar": 6.72,
    },
    {
      "code": "BUFFER_TARGET",
      "formulaText": "round(bufferMonths * monthlyObligationsCents) = round(6.72 * 250000) = 1680000",
      "label": "Cash buffer target",
      "unit": "USD_CENTS",
      "valueCents": 1680000,
    },
    {
      "code": "OPEN_DISPUTE_RESERVE",
      "formulaText": "unheld open dispute exposure not already withheld from the available balance (count: 2) = 60000",
      "label": "Open dispute reserve (unheld)",
      "unit": "USD_CENTS",
      "valueCents": 60000,
    },
    {
      "code": "EXPECTED_REFUND_EXPOSURE",
      "formulaText": "round(round4(45000 / 2001000, 4) * max(baseline, 0)) = round(0.0225 * 520000) = 11700",
      "label": "Expected refund exposure (90-day rate)",
      "unit": "USD_CENTS",
      "valueCents": 11700,
    },
    {
      "code": "TOTAL_RISK_RESERVE",
      "formulaText": "open dispute reserve + expected refund exposure = 60000 + 11700 = 71700",
      "label": "Total risk reserve",
      "unit": "USD_CENTS",
      "valueCents": 71700,
    },
    {
      "code": "SAFE_SURPLUS",
      "formulaText": "max(0, available balance - buffer target - risk reserve) = max(0, 3000000 - 1680000 - 71700) = 1248300",
      "label": "Safe-to-invest surplus",
      "unit": "USD_CENTS",
      "valueCents": 1248300,
    },
    {
      "code": "STAGED_MONTHLY_TRANCHE",
      "formulaText": "floor(safe surplus / 3) with remainder added to tranche 1 (of 3), executeAfterDays = (k - 1) * 30 = 416100",
      "label": "First staging tranche",
      "unit": "USD_CENTS",
      "valueCents": 416100,
    },
  ],
  "bufferMonths": 6.72,
  "bufferTargetCents": 1680000,
  "cv": 0.6199,
  "merchantId": "persona_seasonal_seller",
  "modelStatus": "OK",
  "monthlyObligationsCents": 250000,
  "obligationsSource": "USER_INPUT",
  "riskProfile": "GROWTH",
  "riskReserveCents": 71700,
  "safeSurplusCents": 1248300,
