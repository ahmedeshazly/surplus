{
  "name": "surplus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Surplus: explainable treasury runway and idle-cash allocation advisor for PayPal-paid freelancers and small merchants.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "seed": "tsx scripts/seed.ts",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^20.14",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.6",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
