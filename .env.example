# Copy to .env (git-ignored). Placeholder values only. Never commit real secrets.
# Owner: R1. Keep this file in sync with the variables the code reads.

# PayPal Sandbox REST app credentials (Sandbox only)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# LLM providers (primary: Gemini, fallback: OpenAI)
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# Protects POST /api/admin/reset (send as a request header)
ADMIN_RESET_TOKEN=change-me

# SQLite file. Resolved relative to the REPO ROOT, never the current directory.
DATABASE_PATH=./surplus.db

# Local servers
HOST=127.0.0.1
PORT=4000

# Web app -> API base URL (Next.js public env, baked at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Deprecated alias kept for older web code; prefer NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# API -> web origin allowed by CORS (exact match, no wildcard)
WEB_ORIGIN=http://localhost:3000
